---
import { Image } from "emdash/ui";

const { post } = Astro.props;
---

<article class="insight-card">
  {
    post.image && (
      <a href={`/insights/${post.slug}`} class="insight-card__image-link">
        <Image
  image={post.image}
  alt={post.imageAlt}
  width={800}
  height={450}
/>
      </a>
    )
  }

  <div class="insight-card__content">
    <h2 class="insight-card__title">
      <a href={`/insights/${post.slug}`}>
        {post.title}
      </a>
    </h2>

    <div class="insight-card__excerpt" set:html={post.excerpt} />

    <a href={`/insights/${post.slug}`} class="insight-card__link">
      Read more
    </a>
  </div>
</article>

<style>
  .insight-card {
    border: 1px solid #dddddd;
    border-radius: 8px;
    overflow: hidden;
  }

  .insight-card__image-link {
    display: block;
  }

  .insight-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .insight-card__content {
    padding: 2rem;
  }

  .insight-card__title {
    margin-top: 0;
  }

  .insight-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .insight-card__excerpt {
    margin: 1rem 0;
  }

  .insight-card__link {
    display: inline-block;
    margin-top: 1rem;
  }
</style>
