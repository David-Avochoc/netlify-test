  .step-reveal-card__panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .step-reveal-card__content {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    padding: var(--space-32) var(--space-16);

    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .step-reveal-card__heading {
    flex-shrink: 0;
    margin-top: auto;
    transform: translateY(0);
    transition: transform var(--transition-duration-slow)
      var(--transition-easing);
  }

  .step-reveal-card__number {
    display: block;
    margin-bottom: var(--space-8);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-semibold);
    color: var(--navy);
    line-height: 1.2;
  }

  .step-reveal-card__title {
    margin: 0;
    font-size: var(--font-size-20);
    color: var(--navy);
    font-weight: var(--font-weight-semibold);
    line-height: 1.4;
  }

  .step-reveal-card__details {
    flex-shrink: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-top: 0;
    transition:
      max-height var(--transition-duration-slow) var(--transition-easing),
      margin-top var(--transition-duration-slow) var(--transition-easing),
      opacity var(--transition-duration-standard, 300ms) ease;

    /* Fade out after the collapse animation has begun */
    transition-delay: 0ms, 0ms, 200ms;
  }

  .step-reveal-card__divider {
    height: 1px;
    margin: 0 0 12px;
    background-color: var(--black);
    opacity: 0.5;
  }

  .step-reveal-card__details p {
    margin: 0;
    color: var(--grey-500);
    font-size: var(--font-size-14);
    line-height: 1.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .step-reveal-card:hover .step-reveal-card__details {
      max-height: 20rem;
      margin-top: 12px;
      opacity: 1;

      /* Reveal the description after the heading starts moving up */
      transition-delay: 0ms, 0ms, 100ms;
    }
  }

  @media (hover: none) {
    .step-reveal-card__details {
      max-height: none;
      opacity: 1;
      margin-top: 12px;
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-reveal-card__details {
      transition: none;
    }
  }
</style>
