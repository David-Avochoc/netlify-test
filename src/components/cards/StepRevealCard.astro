---
interface Props {
  step: string;
  title: string;
  description: string;
  icon: string;
  iconAlt?: string;
  class?: string;
  height?: string;
  backgroundColor?: string;
  borderColor?: string;
  textColor?: string;
}

const {
  step,
  title,
  description,
  icon,
  iconAlt = "",
  class: className = "",
  height = "21.25rem",
  backgroundColor = "var(--grey-100)",
  borderColor = "var(--grey-200)",
  textColor = "var(--grey-500)",
} = Astro.props;
---

<article
  class:list={["step-reveal-card", className]}
  style={`--step-reveal-card-height: ${height}; --step-reveal-card-bg: ${backgroundColor}; --step-reveal-card-border: ${borderColor}; --step-reveal-card-text: ${textColor};`}
>
  <div class="step-reveal-card__icon">
    <img src={icon} alt={iconAlt} loading="lazy" />
  </div>

  <div class="step-reveal-card__panel">
    <div class="step-reveal-card__content">
      <div class="step-reveal-card__heading">
        <span class="step-reveal-card__number">{step}</span>
        <h3 class="step-reveal-card__title">{title}</h3>
      </div>

      <div class="step-reveal-card__details">
        <div class="step-reveal-card__divider"></div>
        <p>{description}</p>
      </div>
    </div>
  </div>
</article>

<style>
  .step-reveal-card {
    position: relative;
    isolation: isolate;
    min-width: 0;
    height: var(--step-reveal-card-height);
    overflow: hidden;
    box-sizing: border-box;
    border-radius: 5.82px;
    background-color: var(--step-reveal-card-bg);
    border: 0.485px solid var(--step-reveal-card-border);
    color: var(--step-reveal-card-text);
  }

  .step-reveal-card__icon {
    position: absolute;
    top: var(--space-32);
    left: var(--space-16);
    z-index: 2;
    width: 4rem;
    height: 4rem;
  }

  .step-reveal-card__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

