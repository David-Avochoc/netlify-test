---
interface Props {
  logo?: string;
  logoAlt?: string;
  quote: string;
  name: string;
  role: string;
  company: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  logo,
  logoAlt = "",
  quote,
  name,
  role,
  company,
  ctaText,
  ctaLink,
} = Astro.props;
---

<article class="testimonial-card">
  {
    logo && (
      <div class="testimonial-card__logo">
        <img src={logo} alt={logoAlt} />
      </div>
    )
  }

  <div class="testimonial-card__content">
    <blockquote class="testimonial-card__quote">
      {quote}
    </blockquote>
  </div>

  <div class="testimonial-card__footer">
    <div class="testimonial-card__author">
      <strong>{name}</strong>
      <span>|</span>
      <span>{role}, {company}</span>
    </div>

    <div class="testimonial-card__divider"></div>

    <a href={ctaLink} class="testimonial-card__cta">
      <span>{ctaText}</span>
      <span class="testimonial-card__arrow">
        <img src="/icons/arrow-up-right-drk.svg" alt="" aria-hidden="true" />
      </span>
    </a>
  </div>
</article>

<style>
  .testimonial-card {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-36);
    padding-inline: var(--space-32);
    background: var(--white);
    border-radius: var(--border-radius-small);
    color: var(--navy);
    width: 100%;
  }

  .testimonial-card__logo {
    height: 3.125rem;
    margin-bottom: var(--space-48);
  }

  .testimonial-card__logo img {
    display: block;
    width: 100%;
    max-width: 11.25rem;
    height: auto;
  }

  .testimonial-card__content {
    flex-grow: 1;
  }

  .testimonial-card__quote {
    margin: 0;
    font-size: var(--font-size-18);
    line-height: 1.5;
  }

  .testimonial-card__footer {
    margin-top: var(--space-40);
  }

  .testimonial-card__author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-14);
    line-height: 1.5;
    margin-bottom: 1.875rem;
  }

  .testimonial-card__author strong {
    font-weight: var(--font-weight-bold);
  }

  .testimonial-card__divider {
    width: 100%;
    height: 1px;
    background: var(--grey-300);
    margin-bottom: 1rem;
  }

  .testimonial-card__cta {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: inherit;
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.02em;
  }

  .testimonial-card__cta::after {
    content: "";
    position: absolute;
    top: -1rem;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--navy);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--button-duration) var(--button-easing);
  }
  .testimonial-card__cta:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .testimonial-card__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    transform: translate3d(0, 0, 0);
    transition: transform var(--button-duration) var(--button-easing);
    will-change: transform;
  }
  .testimonial-card__arrow img {
    display: block;
    width: var(--font-size-14);
    height: var(--font-size-14);
    object-fit: contain;
  }

  .testimonial-card__cta:hover .testimonial-card__arrow {
    transform: translate(4px, -4px);
  }

  @media (max-width: 799px) {
    .testimonial-card {
      padding-block: var(--space-36);
      padding-inline: var(--space-20);
      min-width: 23rem;
    }
    .testimonial-card__quote {
      margin: 0;
      font-size: var(--font-size-16);
      line-height: 1.5;
    }
  }
</style>
