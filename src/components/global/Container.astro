---
interface Props {
  class?: string;
  paddingY?: string;
}

const { class: className, paddingY = "0" } = Astro.props;
---

<div
  class:list={["container", className]}
  style={`--container-padding-y: ${paddingY};`}
>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    /*max-width: var(--container-max-width);*/
    padding-inline: var(--section-padding-x);
    padding-block: var(--container-padding-y);
    margin: 0 auto;
  }
  .container:has(.testimonial-section--carousel),
  .container:has(.what-we-build-section__track) {
    padding-inline: 0;
  }
  .container:has(.testimonial-section--carousel) :global(.section-title) {
    padding-inline: var(--section-padding-x);
  }
  @media only screen and (max-width: 799px) {
    .container {
      padding-inline: 1rem;
    }
    .container:has(.testimonial-section) {
      padding-inline: 0;
    }
  }
</style>
