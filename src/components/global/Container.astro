---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["container", className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    /*max-width: var(--container-max-width);*/
    padding-inline: var(--section-padding-x);
    margin: 0 auto;
  }
</style>
