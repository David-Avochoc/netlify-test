---
import Navigation from "./Navigation.astro";
---

<header class="main-header">
  <a href="/" class="main-logo">
    <img src="/images/logos/AvoChoc_Logo_Full.svg" alt="Avochoc" />
  </a>

  <Navigation />
</header>

<style>
  .main-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--nav-padding-x);
    padding-block: var(--nav-padding-y);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }

  .main-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .main-logo img {
    width: auto;
    height: var(--nav-logo-height);
  }
</style>
