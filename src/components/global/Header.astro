---
import Navigation from "./Navigation.astro";
---

<header class="main-header">
  <a href="/" class="main-logo">
    <img src="/images/logos/AvoChoc_Logo_Full.svg" alt="Avochoc" />
  </a>

  <Navigation />
</header>``

<style>
  .main-header {
    max-width: var(--container-max-width);
    width: 100%;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 50px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .main-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .main-logo img {
    height: 32px;
    width: auto;
    max-width: none;
  }
</style>
