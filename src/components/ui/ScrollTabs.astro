---
interface Props {
  tabs: string[];
  scrollHeight?: string;
  gap?: string;
  class?: string;
}
const {
  tabs,
  scrollHeight = "400vh",
  gap = "var(--space-8)",
  class: className = "",
} = Astro.props;
---

<div
  class:list={["scroll-tabs", className]}
  style={`--scroll-tabs-height: ${scrollHeight}; --scroll-tabs-gap: ${gap};`}
>
  <div class="scroll-tabs__sticky">
    <div class="scroll-tabs__inner">
      <div class="scroll-tabs__heading">
        <slot name="heading" />
      </div>

      <div
        class="scroll-tabs__tabs"
        role="tablist"
        aria-label="Section navigation"
      >
        {
          tabs.map((tab, index) => (
            <button
              type="button"
              class:list={["scroll-tabs__tab", { active: index === 0 }]}
              id={`scroll-tab-${index}`}
              role="tab"
              aria-selected={index === 0}
              aria-controls={`scroll-panel-${index}`}
              tabindex="-1"
            >
              {tab}
            </button>
          ))
        }
      </div>

      <div class="scroll-tabs__panels">
        <slot />
      </div>

      <div class="scroll-tabs__footer">
        <slot name="footer" />
      </div>
    </div>
  </div>
</div>

<style>
  .scroll-tabs {
    position: relative;
    height: var(--scroll-tabs-height);
  }
  .scroll-tabs__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--gradient-green-white);
  }
  .scroll-tabs__inner {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-64);
  }
  .scroll-tabs__heading {
    flex-shrink: 0;
    text-align: center;
    margin-bottom: var(--space-32);
  }
  .scroll-tabs__tabs {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--scroll-tabs-gap);
    margin-bottom: var(--space-32);
  }
  .scroll-tabs__tab {
    padding: var(--l-btn-padding-y) var(--l-btn-padding-x);
    border: 1px solid var(--grey-600);
    border-radius: 2.125rem;
    background: transparent;
    color: var(--grey-600);
    font-family: var(--font-family-primary);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
    pointer-events: none;
  }
  .scroll-tabs__tab.active {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }
  .scroll-tabs__panels {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
  }

  :global(.scroll-tabs__panel) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease,
      visibility 0.5s ease;
  }
  :global(.scroll-tabs__panel.active) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    z-index: 2;
  }
  .scroll-tabs__footer {
    flex-shrink: 0;
    text-align: center;
    margin-top: var(--space-32);
  }
</style>

<script>
  function initScrollTabs() {
    const components = document.querySelectorAll(".scroll-tabs");

    components.forEach((component) => {
      const tabs = component.querySelectorAll<HTMLElement>(".scroll-tabs__tab");

      const panels = component.querySelectorAll<HTMLElement>(
        ".scroll-tabs__panel",
      );

      const totalTabs = panels.length;

      if (!totalTabs || tabs.length !== totalTabs) return;

      let currentIndex = -1;

      const setActiveTab = (index: number) => {
        if (index === currentIndex) return;

        currentIndex = index;

        tabs.forEach((tab, i) => {
          const isActive = i === currentIndex;

          tab.classList.toggle("active", isActive);
          tab.setAttribute("aria-selected", String(isActive));
        });

        panels.forEach((panel, i) => {
          const isActive = i === currentIndex;

          panel.classList.toggle("active", isActive);
          panel.setAttribute("aria-hidden", String(!isActive));
        });
      };

      setActiveTab(0);

      const updateFromScroll = () => {
        const rect = component.getBoundingClientRect();

        const scrollableDistance = component.clientHeight - window.innerHeight;

        if (scrollableDistance <= 0) return;

        const scrolled = -rect.top;

        let progress = scrolled / scrollableDistance;

        progress = Math.max(0, Math.min(1, progress));

        let activeIndex = Math.floor(progress * totalTabs);

        if (activeIndex >= totalTabs) {
          activeIndex = totalTabs - 1;
        }

        setActiveTab(activeIndex);
      };

      window.addEventListener("scroll", updateFromScroll, { passive: true });

      updateFromScroll();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollTabs);
  } else {
    initScrollTabs();
  }
</script>
