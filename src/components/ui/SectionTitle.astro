---
interface Props {
  title: string;
  fontSize?: string;
}

const { title, fontSize = "var(--font-size-24)" } = Astro.props;
---

<div class="section-title">
  <h2 style={`font-size: ${fontSize}`}>{title}</h2>
</div>

<style>
  .section-title h2 {
    font-weight: var(--font-weight-semibold);
    line-height: 1.5;
    color: var(--navy);
    text-transform: uppercase;
  }
</style>
