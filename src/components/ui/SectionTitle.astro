---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="section-title">
  <h2>{title}</h2>
</div>

<style>
  .section-title h2 {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-semibold);
    line-height: 1.5;
    color: var(--navy);
    text-transform: uppercase;
  }
</style>
