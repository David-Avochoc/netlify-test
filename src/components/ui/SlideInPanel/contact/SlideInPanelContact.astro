---
import Form from "@/components/forms/Form.astro";
import { formFieldConfig } from "@/components/forms/formFields.js";

const fields = [
  { ...formFieldConfig.fullName, width: "full" as const },
  { ...formFieldConfig.email, width: "full" as const },
  { ...formFieldConfig.phone, width: "full" as const },
  { ...formFieldConfig.message, width: "full" as const },
];
---

<section class="contact-panel-content">
    <div class="contact-panel-content__header">
        <h4>Have a project in mind?</h4>
        <h3>Let's build something amazing together</h3>
        <p>Tell us a little about your project and we will be in touch soonest</p>
    </div>
    <div class="contact-panel-content__form">
        <Form
            title="Fill in your details"
            fields={fields}
            submitLabel="Start a conversation"
            note="No pitch deck. No pressure."
            layout="grid"
            class="contact-section__form"
          />
    </div>
</section>

<style>
  .contact-panel-content {
    display: grid;
    gap: 1rem;
    height: 100%;
    align-content: center;
  }
  .contact-panel-content__header,
  .contact-panel-content__form {
    background: var(--grey);
    border-radius: 1rem;
  }
  .contact-panel-content__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--space-24);
  }
  .contact-panel-content__header h4 {
    color: var(--navy);
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    text-transform: uppercase;
  }
    .contact-panel-content__header h3 {
    color: var(--navy);
    font-size: var(--font-size-48);
    font-weight: var(--font-weight-regular);
  }
    .contact-panel-content__header p {
        color: var(--grey-600);
        font-size: var(--font-size-20);
    }

.contact-panel-content__form {
    padding-block: var(--space-48);
    padding-inline: var(--space-24);
}
.contact-panel-content__form :global(.form__title) {
    font-size: var(--font-size-36);
    padding: 0;
    margin-bottom: var(--space-44);
}
.contact-panel-content__form :global(.contact-section__form) {
    padding-inline: var(--space-32);
}
.contact-panel-content__form :global(.form__control) {
    background: rgba(29, 34, 71, 0.10);
    border-radius: var(--border-radius-xsmall);
}
.contact-panel-content__form :global(.form__control:focus) {
    border-color: var(--grey-400);
}
.contact-panel-content__form :global(.form__field:focus-within .form__label) {
  color: var(--blue);
}
.contact-panel-content__form :global(.form__fields) {
    margin-bottom: var(--space-44);
}
.contact-panel-content__form :global(p.form__note) {
    font-size: var(--font-size-12);
}
</style>
