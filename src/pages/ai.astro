---
import BaseLayout from "../layouts/BaseLayout.astro";
import AiHero from "../sections/aipage/AiHero.astro";
import TheReality from "../sections/aipage/TheReality.astro";
import We_Tell from "../sections/aipage/We_Tell.astro";
import HumanFirst from "../sections/aipage/HumanFirst.astro";
import HowWeWork from "../sections/aipage/HowWeWork.astro";
import WorkWithUs from "../sections/aipage/WorkWithUs.astro";
import DataBackUps from "../sections/aipage/DataBackUps.astro";
import ComplianceFirst from "@/sections/aipage/ComplianceFirst.astro";
import ContactFooter from "@/sections/shared-sections/ContactFooter.astro";
---

<BaseLayout title="AI" description="Progress Done Properly">
  <div class="avochoc-page-sections">
    <div class="aps ai_hero">
      <AiHero />
    </div>
    <div class="aps ai_reality">
      <TheReality />
    </div>
    <div class="aps ai_we_tell">
      <We_Tell />
    </div>
    <div class="aps ai_human_first">
      <HumanFirst />
    </div>
    <div class="aps ai_how_we_work">
      <HowWeWork />
    </div>
    <div class="aps ai_compliance_first">
      <ComplianceFirst />
    </div>
    <div class="aps ai_work_with_us">
      <WorkWithUs />
    </div>
    <div class="aps ai_data_backups">
      <DataBackUps />
    </div>
    <div class="aps ai_contact">
      <ContactFooter />
    </div>
  </div>
</BaseLayout>

<style>
  .avochoc-page-sections {
    display: flex;
    flex-direction: column;
  }
  .ai_hero {
    order: 1;
  }
  .ai_reality {
    order: 2;
  }
  .ai_we_tell {
    order: 3;
  }
  .ai_human_first {
    order: 4;
  }
  .ai_how_we_work {
    order: 5;
  }
  .ai_compliance_first {
    order: 6;
  }
  .ai_work_with_us {
    order: 7;
  }
  .ai_data_backups {
    order: 8;
  }
  .ai_contact {
    order: 9;
  }

  @media screen and (max-width: 799px) {
    .ai_compliance_first {
      order: 4;
    }
    .ai_human_first {
      order: 5;
    }
  }
</style>
