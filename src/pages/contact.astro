---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Form from "@/components/forms/Form.astro";
import { formFieldConfig } from "@/components/forms/formFields.js";
import CallBtn from "@/components/buttons/CallBtn.astro";
import ContactTestimonial from "@/components/ui/Testimonials/ContactTestimonial.astro";
import PrimaryBtn from "@/components/buttons/PrimaryBtn.astro";

const fields = [
  { ...formFieldConfig.fullName, width: "half" as const },
  { ...formFieldConfig.email, width: "half" as const },
  { ...formFieldConfig.company, width: "full" as const },
  { ...formFieldConfig.message, width: "full" as const },
];
---

<BaseLayout title="Contact" description="Progress Done Properly">
  <section class="contact-section">
    <Container>
      <Columns
        layout="50-50"
        gap="var(--space-64)"
        class="contact-section-columns"
      >
        <div class="contact-left-col">
          <SectionTitle
            title="Let's talk about what needs to move forward."
            fontSize="var(--font-size-48)"
            fontWeight="var(--font-weight-semibold)"
            color="var(--white)"
            textTransform="none"
            class="contact-us__title"
          />
          <p class="title-subtxt">
            Tell us what you're working with. We'll tell you what's possible.
          </p>
        </div>

        <div class="contact-right-col">
          <div class="glass-section CTA-section">
            <h2>What are you looking for?</h2>
            <div class="CTA-section__new-project">
              <span class="CTA-icon">
                <img src="/icons/Rectangle6.svg" />
              </span>
              <div class="CTA-section__new-project-content">
                <p class="new-project-content__heading">New Project</p>
                <p class="new-project-content__body">
                  Something needs building, fixing, modernising or figuring out.
                </p>
              </div>
            </div>
            <div class="CTA-section__existing-client">
              <span class="CTA-icon">
                <img src="/icons/Rectangle6.svg" />
              </span>
              <div class="CTA-section__new-project-content">
                <p class="new-project-content__heading">Existing Client</p>
                <p class="new-project-content__body">
                  Good to hear from you. Tell us what you need and we'll get the
                  right person on it.
                </p>
              </div>
            </div>
            <div class="CTA-section__careers">
              <span class="CTA-icon">
                <img src="/icons/Rectangle6.svg" />
              </span>
              <div class="CTA-section__new-project-content">
                <p class="new-project-content__heading">Careers</p>
                <p class="new-project-content__body">
                  Looking to become an Avo? Head this way.
                </p>
              </div>
            </div>
          </div>
          <div class="glass-section contact-form-section">
            <h2>Tell us a little about what you need.</h2>
            <Form
              fields={fields}
              submitLabel="Start a conversation"
              note="No pitch deck. No pressure."
              layout="grid"
              class="contact-section__form"
            />
          </div>
          <div class="avo-talk">
            <div class="avo-talk__left">
              <h2>Rather talk it through first?</h2>
              <div class="avo-talk-inner">
                <p>
                  Book fifteen minutes with our team.
                  <br /> No forms, no waiting.
                </p>
                <CallBtn
                  href="#"
                  text="Book a call"
                  background="var(--navy)"
                  textColor="var(--white)"
                />
              </div>
            </div>
            <div class="avo-talk__right">
              <img src="/images/content/staff/Ceo_COO.webp" />
            </div>
          </div>
          <div class="glass-section serious-tech-section">
            <h2>Serious technology. Actual Humans.</h2>
            <p>
              Your message goes straight to the people who can work out what
              needs to happen next, whether that's a conversation with strategy,
              engineering, AI or design.
            </p>
            <hr />
            <p>ISO 27001 [accrediting body]. POPIA and GDPR compliant.</p>
            <div class="serious-tech-section-location">
              <div class="serious-tech-section-location_1">
                <span class="icon">
                  <img src="/icons/location_marker_drk.svg" />
                </span>
                <p>Based in South Africa</p>
              </div>
              <div class="serious-tech-section-location_1">
                <span class="icon">
                  <img src="/icons/globe.svg" />
                </span>
                <p>Based in South Africa</p>
              </div>
            </div>
          </div>
          <ContactTestimonial />
        </div>
      </Columns>
      <div class="avo-contact">
        <SectionTitle
          title="Just a conversation with people who know what they're doing."
          fontSize="var(--font-size-36)"
          fontWeight="var(--font-weight-medium)"
          color="var(--navy)"
          textTransform="none"
          class="avo-contact__title"
        />
        <div class="avo-genius-cta">
          <div class="avo-genius-cta_1">
            <span class="CTA-icon">
              <img src="/icons/Rectangle6.svg" />
            </span>
            <p>No pressure</p>
          </div>
          <div class="avo-genius-cta_1">
            <span class="CTA-icon">
              <img src="/icons/Rectangle6.svg" />
            </span>
            <p>No pitch</p>
          </div>
        </div>
        <PrimaryBtn
          href="#"
          text="Ready When You Are"
          background="var(--navy)"
          textColor="var(--white)"
        />
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .contact-section {
    background: url("/images/backgrounds/section/avo-contact.webp");
    background-position: center top;
    background-repeat: no-repeat;
    background-size: cover;
    padding-top: 200px;
  }
  .contact-left-col :global(.contact-us__title h2) {
    line-height: 1.25;
    margin-bottom: var(--space-16);
  }
  .title-subtxt {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    color: var(--white);
  }
  .contact-right-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .contact-right-col .glass-section {
    background: var(--white-50);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    width: 100%;
    border-radius: 1rem;
  }
  .CTA-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-24);
  }
  .CTA-section h2,
  .contact-form-section h2,
  .avo-talk h2,
  .serious-tech-section h2 {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    color: var(--navy);
    text-transform: uppercase;
    margin-bottom: var(--space-16);
  }
  .contact-form-section h2 {
    margin-bottom: var(--space-32);
  }
  .serious-tech-section h2 {
    margin-bottom: 0;
  }
  .CTA-section__new-project,
  .CTA-section__existing-client,
  .CTA-section__careers {
    display: flex;
    gap: var(--space-16);
    border: 1px solid var(--white);
    padding-block: var(--space-8);
    padding-inline: var(--space-16);
  }
  .CTA-icon {
    margin: auto 0;
  }
  .new-project-content__heading {
    font-size: var(--font-size-18);
    font-weight: var(--font-weight-regular);
    line-height: 1.5;
    color: var(--navy);
  }
  .new-project-content__body {
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-regular);
    line-height: 1.5;
    color: var(--grey-600);
  }
  .contact-form-section {
    padding-block: var(--space-48) var(--space-12);
    padding-inline: var(--space-24);
  }
  :global(.form__control::placeholder) {
    color: var(--navy) !important;
  }
  :global(.form__control) {
    border: 1px solid var(--navy) !important;
    background: transparent !important;
  }
  .avo-talk {
    display: flex;
    flex-direction: row;
    gap: var(--space-24);
    padding: var(--space-24);
    background: var(--lime);
    border-radius: 1rem;
  }
  .avo-talk__left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .avo-talk-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    align-items: start;
    color: var(--grey-600);
  }
  .serious-tech-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--space-24);
  }
  .serious-tech-section p {
    font-size: var(--font-size-18);
    font-weight: var(--font-weight-regular);
    color: var(--grey-600);
  }
  .serious-tech-section-location {
    display: flex;
    gap: var(--space-16);
  }
  .serious-tech-section-location_1 {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-16);
    border: 1px solid var(--white);
    backdrop-filter: blur(22.5px);
    -webkit-backdrop-filter: blur(22.5px);
  }

  .serious-tech-section-location_1 .icon {
    display: inline-flex;
    flex: 0 0 auto;
  }

  .serious-tech-section-location_1 .icon img {
    display: block;
    width: 20px;
    height: 20px;
  }

  .serious-tech-section-location_1 p {
    margin: 0;
    width: auto;
    flex: 0 1 auto;
  }
  .avo-contact {
    margin-top: 7.185rem;
    padding-block: var(--space-120);
    text-align: center;
  }
  .avo-genius-cta {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
    padding-block: var(--space-24);
  }
  .avo-genius-cta_1 {
    display: flex;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-4);
    padding-inline: var(--space-8);
    background: var(--grey);
    border-radius: var(--border-radius-small);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    color: var(--navy);
    text-transform: uppercase;
  }

  @media screen and (max-width: 799px) {
    :global(.primary-btn.form__submit),
    :global(.call-btn),
    .serious-tech-section-location_1 {
      width: 100%;
    }
    .avo-talk-inner {
      gap: var(--space-16);
    }
    .avo-talk {
      flex-wrap: wrap;
    }
    .serious-tech-section-location {
      flex-wrap: wrap;
    }
    .avo-contact {
      margin-top: var(--space-24);
      padding-block: var(--space-64);
    }
  }
</style>
