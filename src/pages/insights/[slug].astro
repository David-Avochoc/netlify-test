---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, getPostBySlug } from "../../api/wordpress/posts.js";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: {
      slug: post.slug,
    },
  }));
}

const { slug } = Astro.params;

const post = await getPostBySlug(slug);
---

<BaseLayout title={post.title}>
  <main class="insight">
    <article class="insight__article">
      <a href="/insights" class="insight__back"> ← Back to Insights </a>

      <header class="insight__header">
        <p class="insight__date">
          {new Date(post.date).toLocaleDateString()}
        </p>

        <h1>{post.title}</h1>
      </header>

      {
        post.image && (
          <div class="insight__image-wrapper">
            <img src={post.image} alt={post.imageAlt} class="insight__image" />
          </div>
        )
      }

      <div class="insight__content" set:html={post.content} />
    </article>
  </main>
</BaseLayout>

<style>
  .insight {
    padding: 6rem 2rem;
  }

  .insight__article {
    max-width: 800px;
    margin: 0 auto;
  }

  .insight__back {
    display: inline-block;
    margin-bottom: 3rem;
  }

  .insight__date {
    margin-bottom: 1rem;
  }

  .insight__image-wrapper {
    margin-top: 3rem;
  }

  .insight__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .insight__content {
    margin-top: 3rem;
  }
</style>
