
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { decodeSlug, getEmDashEntry } from "emdash";
import { Image, PortableText } from "emdash/ui";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
  return Astro.rewrite("/404");
}

const { entry: post, error } = await getEmDashEntry("posts", slug);

if (error) {
  throw error;
}

if (!post) {
  return Astro.rewrite("/404");
}
---

<BaseLayout title={post.data.title}>
  <main class="insight">
    <article class="insight__article">
      <a href="/insights" class="insight__back">
        ← Back to Insights
      </a>

      <h1>{post.data.title}</h1>
      {post.data.featured_image && (
  <div class="insight__featured-image">
    <Image
      image={post.data.featured_image}
      alt={post.data.title}
      width={1200}
      height={675}
    />
  </div>
)}

      {post.data.excerpt && (
        <p class="insight__excerpt">{post.data.excerpt}</p>
      )}

      <div class="insight__content">
        <PortableText value={post.data.content} />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .insight {
    padding: 6rem 2rem;
  }

  .insight__article {
    max-width: 800px;
    margin: 0 auto;
  }

  .insight__featured-image {
  margin: 2rem 0;
}

.insight__featured-image img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
}

  .insight__back {
    display: inline-block;
    margin-bottom: 3rem;
  }

  .insight__excerpt {
    font-size: 1.2rem;
    margin: 1.5rem 0 2rem;
  }

  .insight__content {
    margin-top: 2rem;
  }
</style>
