
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InsightsGrid from "../../sections/insights/InsightsGrid.astro";
import { getEmDashCollection } from "emdash";

const { entries, error } = await getEmDashCollection("posts");

if (error) {
  throw error;
}

const posts = entries.map(({ data }) => {
  const textBlocks = (data.content ?? [])
    .flatMap((block) => block.children ?? [])
    .filter((child) => child._type === "span")
    .map((child) => child.text)
    .filter(Boolean);

  return {
    title: data.title,
    slug: data.slug,
    image: data.featured_image,
    imageAlt: data.title,
    excerpt: data.excerpt || textBlocks.join(" ").slice(0, 180),
  };
});
---

<BaseLayout title="Insights">
  <main>
    <section class="insights-page-header">
      <div class="insights-page-header__container">
        <h1>Insights</h1>
        <p>Explore our latest articles, news and ideas.</p>
      </div>
    </section>

    <InsightsGrid posts={posts} />
  </main>
</BaseLayout>

<style>
  .insights-page-header {
    padding: 6rem 2rem 2rem;
  }

  .insights-page-header__container {
    max-width: 1200px;
    margin: 0 auto;
  }
</style>
