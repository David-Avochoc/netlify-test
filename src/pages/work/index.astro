---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ourWork from "@/data/ourWork.js";

type OurWorkProject = {
  slug: string;
  title: string;
  description: string;
  featuredImage: string | null;
  hoverImage: string | null;
  imageAlt: string | null;
  logo: string;
  brandColor: string;
  cardVisual: "image" | "brand";
  publishDate: string;
  category: string;
  tags: string[];
  status?: "coming-soon";
};

const projects = ourWork as OurWorkProject[];

const recentProjects = [...projects]
  .sort(
    (a, b) =>
      new Date(b.publishDate).getTime() -
      new Date(a.publishDate).getTime(),
  )
  .slice(0, 5);
---

<BaseLayout title="Our Work">
  <section class="recent-projects">
    <h2>Recent Projects</h2>

    <div class="recent-projects__grid">
      {recentProjects.map((project) => (
        <article class="recent-projects__card">
          {project.status === "coming-soon" ? (
            <button
              type="button"
              class="recent-projects__card-link"
              data-panel-open="contact-panel"
            >
              <div
                class:list={[
                  "recent-projects__visual",
                  project.cardVisual === "brand" &&
                    "recent-projects__visual--brand",
                ]}
                style={
                  project.cardVisual === "brand"
                    ? `--brand-color: ${project.brandColor}`
                    : undefined
                }
              >
                {project.cardVisual === "brand" ? (
                  <img
                    src={project.logo}
                    alt={`${project.title} logo`}
                  />
                ) : project.featuredImage ? (
                  <img
                    src={project.featuredImage}
                    alt={project.imageAlt || project.title}
                  />
                ) : null}
              </div>

              <p>{project.category}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>

              <span class="recent-projects__status">
                Coming Soon
              </span>
            </button>
          ) : (
            <a
              class="recent-projects__card-link"
              href={`/work/${project.slug}/`}
            >
              <div
                class:list={[
                  "recent-projects__visual",
                  project.cardVisual === "brand" &&
                    "recent-projects__visual--brand",
                ]}
                style={
                  project.cardVisual === "brand"
                    ? `--brand-color: ${project.brandColor}`
                    : undefined
                }
              >
                {project.cardVisual === "brand" ? (
                  <img
                    src={project.logo}
                    alt={`${project.title} logo`}
                  />
                ) : project.featuredImage ? (
                  <img
                    src={project.featuredImage}
                    alt={project.imageAlt || project.title}
                  />
                ) : null}
              </div>

              <p>{project.category}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>

              <span class="recent-projects__cta">
                View Case Study
              </span>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>

.recent-projects__visual {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
}

.recent-projects__visual img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.recent-projects__visual--brand {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--brand-color);
}

.recent-projects__visual--brand img {
  width: 60%;
  height: 60%;
  object-fit: contain;
}

</style>