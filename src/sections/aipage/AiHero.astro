---
import "../../styles/fonts.css";
import "../../styles/tokens.css";
import "../../styles/typography.css";

const { 
  backgroundImage = "/images/Ai-Page/AI-hero.svg" 
} = Astro.props;
---

<section 
  class="ai-hero" 
  id="ai-hero-section"
  style={`background-image: url('${backgroundImage}');`}
>
  <div class="glass-bobble" id="glass-bobble"></div>

  <div class="ai-hero__container">
    
    <!-- Left Column: Headline -->
    <div class="column left-col">
      <h2>
        [AI] that<br/>
        <span class="highlight">earns its place.</span>
      </h2>
    </div>

    <!-- Right Column: Text and Buttons -->
    <div class="column right-col">
      <p>
        We build custom software, AI, and integrated systems for organisations operating under conditions where failure is expensive, visible, and hard to undo.
      </p>

      <div class="button-group">
      
      </div>
    </div>

  </div>
</section>

<style>
  .ai-hero {
    width: 100%;
    height: 100vh; 
    min-height: 700px; 
    background-color: var(--navy); 
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    font-family: var(--font-family-primary);
    overflow: hidden; 
    cursor: none; 
    display: flex;
    align-items: center; 
  }

  .ai-hero__container {
    width: 100%;

    max-width: var(--container-max-width, 1440px); 
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    position: relative;
    z-index: 2; 
  }

  .glass-bobble {
    position: fixed;
    top: 0;
    left: 0;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    pointer-events: none; 
    z-index: 9999;
    opacity: 0;
    transform: translate(-50%, -50%); 
    
    background: radial-gradient(130% 130% at 20% 20%, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.01) 100%);
    backdrop-filter: blur(8px) brightness(1.1);
    -webkit-backdrop-filter: blur(8px) brightness(1.1);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 
      inset 0 0 20px rgba(255, 255, 255, 0.1),
      0 10px 30px rgba(0, 0, 0, 0.2);
    
    transition: opacity 0.3s ease, transform 0.1s linear; 
  }

  .left-col h2 {
    font-size: var(--font-size-60);
    font-weight: var(--font-weight-bold);
    color: var(--white);
    line-height: 1.1;
    margin: 0;
    letter-spacing: -1px;
  }

  .highlight {
    color: #00f0ff; 
  }

  .right-col {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .right-col p {
    font-size: var(--font-size-18); 
    line-height: 1.6;
    color: var(--white);
    margin: 0;
    font-weight: var(--font-weight-regular);
    max-width: 500px;
  }

  .button-group {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: stretch;
    text-decoration: none;
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.5px;
    transition: opacity 0.3s ease;
    cursor: pointer; 
  }

  .action-btn:hover {
    opacity: 0.8;
  }

  .action-btn .text {
    padding: 14px 20px;
    display: flex;
    align-items: center;
  }

  .action-btn .icon {
    background-color: var(--lime); 
    color: var(--navy);
    padding: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-outlined {
    border: 1px solid var(--white);
    color: var(--white);
    background-color: transparent;
  }

  .btn-solid {
    background-color: var(--white);
    color: var(--navy);
  }

  @media (max-width: 1024px) {
    .ai-hero {
      height: auto; 
      padding: 120px 0;
      cursor: auto; 
    }
    
    .glass-bobble {
      display: none; 
    }

    .ai-hero__container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

<script>
  function initBobbleCursor() {
    const section = document.getElementById('ai-hero-section');
    const bobble = document.getElementById('glass-bobble');

    if (!section || !bobble) return;

    section.addEventListener('mouseenter', () => {
      bobble.style.opacity = '1';
    });

    section.addEventListener('mouseleave', () => {
      bobble.style.opacity = '0';
    });

    section.addEventListener('mousemove', (e) => {
      const x = e.clientX - 75;
      const y = e.clientY - 75;
      bobble.style.transform = `translate(${x}px, ${y}px)`;
    });
  }

  document.addEventListener('DOMContentLoaded', initBobbleCursor);
</script>
