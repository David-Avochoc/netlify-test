---
import Hero from "@/sections/shared-sections/Hero.astro";
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SecondaryBtn from "@/components/buttons/SecondaryBtn.astro";
import PrimaryBtn from "@/components/buttons/PrimaryBtn.astro";
---

<section class="ai-hero-section" id="ai-hero-section">
  <div id="hero-content">
    <Hero backgroundImage="/images/backgrounds/ai_header.webp">
      <Container>
        <Columns class="ai-hero-container" layout="50-50" align="stretch">
          <div class="ai-hero-left">
            <h1>
              [AI] that<br /><span class="gradient-text">earns its place</span>
            </h1>
          </div>
          <div class="ai-hero-right">
            <p>
              We build custom software, AI, and integrated systems for
              organisations operating under conditions where failure is expensive,
              visible, and hard to undo.
            </p>
            <div class="hero__actions">
              <SecondaryBtn href="/contact" text="Talk to our team" />
              <PrimaryBtn
                href="#"
                text="Take our AI maturity assessment"
                background="var(--white)"
                textColor="var(--navy)"
              />
            </div>
          </div>
        </Columns>
      </Container>
    </Hero>
  </div>

  <div class="glass-bobble" id="glass-bobble">
    <div class="glass-content" id="glass-content"></div>
    <div class="glass-overlay"></div>
  </div>
</section>

<style>
  .ai-hero-section {
    position: relative;
    cursor: none; /* Hides default cursor */
  }

  :global(.ai-hero-container.columns--stack) {
    padding-top: 7.75rem;
    min-height: 22.813rem;
  }
  .ai-hero-left h1 {
    font-size: var(--font-size-60);
    font-weight: var(--font-weight-semibold);
    color: var(--white);
    letter-spacing: -0.075rem;
  }
  .ai-hero-left .gradient-text {
    background: var(--gradient-cyan-lime);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline;
  }
  .ai-hero-right {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .ai-hero-right p {
    font-size: var(--font-size-20);
    font-weight: var(--font-weight-medium);
    color: var(--white);
    padding-bottom: var(--space-24);
    max-width: 36.68rem;
    margin-top: auto;
    margin-bottom: 0px;
  }
  .hero__actions {
    display: flex;
    gap: var(--space-16);
  }

  .glass-bobble {
    position: fixed;
    top: 0;
    left: 0;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .glass-content {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    filter: contrast(1.1);
  }
  
  .glass-content > div {
    width: 100%;
    height: 100%;
  }

  .glass-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    box-shadow:
      inset 0 0 8px rgba(255, 255, 255, 0.9),
      inset 10px 0 25px rgba(255, 0, 255, 0.4),
      inset -10px 0 25px rgba(0, 255, 255, 0.5),
      inset 0 10px 25px rgba(0, 255, 120, 0.4),
      inset 0 -10px 25px rgba(50, 100, 255, 0.4),
      0 15px 30px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.9);
    background:
      radial-gradient(
        ellipse at 25% 25%,
        rgba(255, 255, 255, 0.6) 0%,
        rgba(255, 255, 255, 0) 10%
      ),
      radial-gradient(
        ellipse at 75% 75%,
        rgba(255, 255, 255, 0.15) 0%,
        rgba(255, 255, 255, 0) 30%
      );
  }

  @media (max-width: 1024px) {
    .glass-bobble {
      display: none;
    }
    .ai-hero-section {
      cursor: auto;
    }
  }
</style>

<script>
  function initTrueMagnifier() {
    const section = document.getElementById("ai-hero-section");
    const bobble = document.getElementById("glass-bobble");
    const glassContent = document.getElementById("glass-content");
    const heroContent = document.getElementById("hero-content");

    if (!section || !bobble || !glassContent || !heroContent) return;

    glassContent.appendChild(heroContent.cloneNode(true));

    const scale = 1.7;
    const bobbleSize = 250;
    const radius = bobbleSize / 2;

    let mouseX = 0;
    let mouseY = 0;
    let isHovering = false;

    function updateMagnifier() {
      if (!isHovering) {
        bobble.style.opacity = "0";
        return;
      }

      const rect = section.getBoundingClientRect();

      const hitLeft = (mouseX - radius) <= rect.left;
      const hitRight = (mouseX + radius) >= rect.right;
      const hitTop = (mouseY - radius) <= rect.top;
      const hitBottom = (mouseY + radius) >= rect.bottom;

      if (hitLeft || hitRight || hitTop || hitBottom) {
        bobble.style.opacity = "0";
      } else {
        bobble.style.opacity = "1";
      }

      bobble.style.transform = `translate(${mouseX - radius}px, ${mouseY - radius}px)`;

      glassContent.style.width = `${rect.width}px`;
      glassContent.style.height = `${rect.height}px`;

      const relX = mouseX - rect.left;
      const relY = mouseY - rect.top;

      const innerX = -relX * scale + radius;
      const innerY = -relY * scale + radius;
      
      glassContent.style.transform = `translate(${innerX}px, ${innerY}px) scale(${scale})`;
    }

    section.addEventListener("mouseenter", () => {
      isHovering = true;
      updateMagnifier();
    });

    section.addEventListener("mouseleave", () => {
      isHovering = false;
      bobble.style.opacity = "0";
    });

    section.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      updateMagnifier();
    });

    window.addEventListener('scroll', () => {
      if (isHovering) {
        updateMagnifier();
      }
    }, { passive: true });
  }

  document.addEventListener("DOMContentLoaded", initTrueMagnifier);
</script>
