---
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import HighlightSection from "@/components/ui/HighlightSection.astro";
---

<section class="compliance-first-section">
  <Container>
    <SectionTitle
      title="Compliance isn't an afterthought. It's the starting point."
      fontSize="var(--font-size-36)"
      color="var(--navy)"
      class="compliance-first__title"
    />

    <HighlightSection
      columns={3}
      customColumns="9.75rem minmax(0, 1fr) minmax(0, 1fr)"
      background="transparent"
      textColor="var(--navy)"
      padding="var(--space-8) var(--space-16)"
      minHeight="21.562rem"
    >
      <div class="iso-certification-badge">
        <img src="/images/iso_badge.svg" alt="ISO Certification" />
      </div>

      <div class="iso-heading">
        <span class="certified-pill">ISO 27001 Certified</span>
        <h4>
          The internationally recognised standard for information security
          management.
        </h4>
      </div>

      <div class="iso-description">
        <p>
          For an AI partner, that matters more than most. Building or
          integrating AI means access to your systems, your data, and often your
          most sensitive workflows. ISO 27001 means that access is governed by
          an independently audited system, not just good intentions.
        </p>
      </div>
    </HighlightSection>
    <div class="other-compliance">
      <div class="gdpr-compliance">
        <h4>GDPR & POPIA</h4>
        <p>We build to GDPR and POPIA requirements from day one.</p>
      </div>
      <div class="ongoing-compliance">
        <h4>Ongoing Governance</h4>
        <p>
          Governance isn't a document we hand you once. We help you set it up,
          keep it working, and revisit it as AI changes - because this is a
          partnership, not a one-and-done project.
        </p>
      </div>
    </div>
  </Container>
</section>

<style>
  .compliance-first-section {
    padding-block: var(--space-80);
    background-color: var(--grey);
  }

  :global(.compliance-first-section .container) {
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
  }

  .iso-certification-badge img {
    display: block;
    width: 100%;
    height: auto;
  }

  .certified-pill {
    background-color: var(--grey-300);
    border-radius: 34px;
    padding-inline: var(--space-16);
    padding-block: var(--space-8);
    color: var(--navy);
    font-size: var(--font-size-12);
    text-transform: uppercase;
    font-weight: var(--font-weight-medium);
  }

  .iso-heading h4 {
    font-size: var(--font-size-36);
    font-weight: var(--font-weight-regular);
    line-height: 1.2;
    letter-spacing: -0.045rem;
    max-width: 26.062rem;
    margin-top: var(--space-8);
  }

  .iso-description p {
    font-size: var(--font-size-24);
    line-height: 1.3;
    max-width: 28.812rem;
  }

  .other-compliance h4 {
    font-size: var(--font-size-30);
    font-weight: var(--font-weight-regular);
    color: var(--charcoal);
    line-height: 1;
  }
  .other-compliance p {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-regular);
    color: var(--charcoal);
    line-height: 1.3;
  }
  .gdpr-compliance,
  .ongoing-compliance {
    display: flex;
    gap: var(--space-16);
  }
  .gdpr-compliance {
    padding-bottom: var(--space-24);
    border-bottom: 1px solid var(--navy);
  }
  .ongoing-compliance {
    padding-top: var(--space-24);
  }
  .gdpr-compliance h4,
  .gdpr-compliance p,
  .ongoing-compliance h4,
  .ongoing-compliance p {
    flex: 1;
    min-width: 0;
  }
</style>
