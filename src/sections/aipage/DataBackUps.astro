---
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import StatCard from "@/components/cards/StatCard.astro";
import PrimaryBtn from "@/components/buttons/PrimaryBtn.astro";
---

<section class="data-backup-section">
  <Container>
    <SectionTitle
      title="The data backs up why we work this way."
      fontSize="var(--font-size-36)"
      fontWeight="var(--font-weight-regular"
      textTransform="capitalize"
      color="var(--navy)"
      class="data-backup__title"
    />
    <Columns
      layout="33-33-33"
      gap="var(--space-16)"
      align="center"
      class="data-backup-columns"
    >
      <StatCard
        label="The upside"
        cardBackgroundImage="/images/backgrounds/cards/backgroundgradient3.webp"
        cardTitle="14-34%"
        cardDescription="Increase in worker productivity from generative AI tools — rising to 34% for newer or less experienced staff."
        cardSource="Quarterly Journal of Economics"
        cardSourceIcon="/icons/book-bookmark.svg"
      />
      <StatCard
        label="The reality"
        cardBackgroundImage="/images/backgrounds/cards/backgroundgradient1.webp"
        cardTitle="40%+"
        cardDescription="Of agentic AI projects expected to be cancelled before the end of 2027, largely due to unclear business value and weak governance."
        cardSource="Gartner"
        cardSourceIcon="/icons/book-bookmark.svg"
      />
      <StatCard
        label="The trust gap"
        cardBackgroundImage="/images/backgrounds/cards/backgroundgradient2.webp"
        cardTitle="Unreliable AI outputs make buyers less confident in their decisions, not more."
        cardTitleSize="var(--font-size-30)"
        cardDescription="Vague AI claims don't build trust. Evidence does."
        cardSource="Forrester"
        cardSourceIcon="/icons/book-bookmark.svg"
      />
    </Columns>
    <div class="backup-data-statement">
      <p>
        This is exactly why we lead with mapping, governance, and honesty about
        fit<span class="light-txt"> - instead of the hype.</span>
      </p>
    </div>
    <div class="backup-data-cta">
      <PrimaryBtn
        href="#"
        text="See Principles"
        background="var(--grey)"
        textColor="var(--navy)"
      />
      <PrimaryBtn
        href="#"
        text="See Insights"
        background="var(--grey)"
        textColor="var(--navy)"
      />
    </div>
  </Container>
</section>

<style>
  .data-backup-section {
    padding-block: var(--space-80);
  }
  :global(.data-backup-section .container) {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }
  :global(.data-backup-columns.columns) {
    max-width: 60.625rem;
    margin: auto;
  }
  .backup-data-statement p {
    color: var(--navy);
    font-size: var(--font-size-24);
    line-height: 1.333;
    text-align: center;
  }
  .backup-data-statement p .light-txt {
    color: var(--grey-500);
  }
  .backup-data-cta {
    display: flex;
    gap: var(--space-16);
    margin: auto;
  }
  @media screen and (max-width: 799px) {
    :global(.data-backup-columns.columns) {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    :global(.data-backup-columns.columns > :nth-child(3)) {
      order: 1;
      position: sticky;
      top: 55px;
      z-index: 1;
    }

    :global(.data-backup-columns.columns > :nth-child(2)) {
      order: 2;
      position: sticky;
      top: 105px;
      z-index: 2;
    }

    :global(.data-backup-columns.columns > :nth-child(1)) {
      order: 3;
      position: sticky;
      top: 155px;
      z-index: 3;
    }

    :global(.data-backup-columns .stat-card) {
      margin: 0;
      gap: 0 !important;
    }

    .backup-data-statement p {
      text-align: left;
    }

    .backup-data-cta {
      flex-direction: column;
      margin: 0;
    }
  }
</style>
