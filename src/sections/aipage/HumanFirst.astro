---
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import PrimaryBtn from "@/components/buttons/PrimaryBtn.astro";
---

<section class="human-first-section">
  <Container>
    <Columns layout="40-60" gap="0" class="human-first__columns">
      <div class="human-first__left">
        <SectionTitle
          title="Human-first"
          fontSize="var(--font-size-36)"
          color="var(--white)"
          class="human-first__title"
        />
        <SectionTitle
          title="Not AI-First"
          fontSize="var(--font-size-36)"
          color="transparent"
          class="human-first__title2"
        />
      </div>
      <div class="human-first__right">
        <p class="into-txt">
          A lot of AI-first companies start with the AI. Brainstorm with AI,
          architect with AI, build with AI, and check the output with a human at
          the end.
        </p>
      </div>
    </Columns>
  </Container>
  <Container>
    <Columns layout="40-60" gap="0" class="human-first__columns2">
      <div class="human-first__left2">
        <img
          src="/images/content/staff/avo_humans_first.webp"
          alt="Staff working"
        />
      </div>

      <div class="human-first__right2">
        <div class="into-txt2">
          <p>
            We work the other way. Our people lead the thinking. AI is a tool
            inside that process, not a replacement for it.
          </p>
          <p>
            That means the humans making decisions about your systems understand
            your business first, and reach for AI because it earns its place,
            not because it's trendy.
          </p>
          <p>Effective business AI integration. Not AI for its own sake.</p>
        </div>
        <PrimaryBtn
          href="#"
          text="Learn more about ai integration"
          background="var(--white)"
          textColor="var(--navy)"
        />
      </div>
    </Columns>
  </Container>
</section>

<style>
  .human-first-section {
    padding-block: var(--space-80);
    background-color: var(--olivegreen);
  }
  .human-first__left {
    border-right: 1px solid var(--white);
  }
  :global(.human-first__title) {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--white);
  }
  :global(.human-first__title2 h2) {
    background: var(--gradient-green-lime);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-align: right;
    padding-block: var(--space-16);
    padding-inline: var(--space-16);
  }
  .human-first__right {
    display: flex;
    flex-direction: column;
    align-self: flex-end;
    padding: 0 0 var(--space-16) var(--space-32);
  }
  .human-first__right p {
    font-size: var(--font-size-30);
    line-height: 1.26;
    color: var(--white);
    max-width: 37rem;
  }
  :global(.human-first__columns) {
    border-bottom: 1px solid var(--white);
  }
  :global(.human-first__columns2) {
    padding-top: var(--space-48);
  }
  .human-first__left2 {
    padding-right: var(--space-16);
  }
  .human-first__left2 img {
    display: block;
    width: 100%;
    height: auto;
  }
  .human-first__right2 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-48);
    padding-left: var(--space-32);
    margin-block: auto;
  }

  .human-first__right2 .into-txt2 {
    max-width: 41.25rem;
  }

  .human-first__right2 p {
    font-size: var(--font-size-20);
    font-weight: var(--font-weight-medium);
    line-height: 1.5;
    color: var(--white);
    margin: 0;
  }

  .human-first__right2 .into-txt2 p + p {
    margin-top: var(--space-12);
  }
</style>
