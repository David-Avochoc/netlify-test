// Import your global styles if they aren't already imported in your BaseLayout
// import "../styles/fonts.css";
// import "../styles/tokens.css";
// import "../styles/typography.css";
---

<section class="the-reality">
  <!-- Top Gradient Line -->
  <div class="the-reality__gradient-bar"></div>
  
  <div class="the-reality__container">
    
    <!-- Column 1: Title -->
    <div class="column col-1">
      <h2>THE REALITY</h2>
    </div>

    <!-- Column 2: Main Hook -->
    <div class="column col-2">
      <h3>
        Everyone says they do AI.<br/>
        Most of it never leaves<br/>
        the prototype stage.
      </h3>
    </div>

    <!-- Column 3: Body Text & Highlight Box -->
    <div class="column col-3">
      <p>AI is not short on promises. It is short on production.</p>
      
      <p>Independent research puts real, production grade AI adoption far lower than the marketing suggests. Most AI initiatives stall. Most spend never shows up in the numbers.</p>
      
      <p>The problem is rarely the model. It is usually the workflow nobody mapped, the data nobody prepared, or the AI first build nobody validated against how the business actually runs.</p>

      <div class="highlight-box">
        That gap is where we work.
      </div>
    </div>

  </div>
</section>

<style>
  .the-reality {
    width: 100%;
    background-color: var(--white);
    position: relative;
    font-family: var(--font-family-primary); /* Ensures Outfit is applied if not inherited */
  }

  .the-reality__gradient-bar {
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #2563eb 0%, #7c3aed 50%, #db2777 100%); 
  }

  .the-reality__container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 100px 50px;
    display: grid;
    grid-template-columns: 1fr 1.5fr 1.5fr; 
  }

  /* --- Columns & Borders --- */
  .column {
    display: flex;
    flex-direction: column;
  }

  .col-1 {
    padding-right: 40px;
  }

  .col-2 {
    border-left: 1px solid var(--grey-300);
    padding: 0 40px;
  }

  .col-3 {
    border-left: 1px solid var(--grey-300);
    padding-left: 40px;
  }

  .col-1 h2 {
    font-size: var(--font-size-36);
    font-weight: var(--font-weight-bold);
    color: var(--navy);
    margin: 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .col-2 h3 {
    font-size: var(--font-size-36); 
    line-height: 1.3;
    font-weight: var(--font-weight-medium);
    color: var(--navy);
    margin: 0;
    letter-spacing: -0.5px;
  }

  .col-3 p {
    font-size: var(--font-size-16);
    line-height: 1.6;
    color: var(--charcoal);
    margin: 0 0 24px 0;
  }


  /* --- Highlight Box --- */
  .highlight-box {
    background-color: var(--grey-100); 
    padding: 16px 24px;
    font-size: var(--font-size-20);
    font-weight: var(--font-weight-medium);
    color: var(--navy);
    display: inline-block;
    margin-top: 16px;
    position: relative;
  }

  /* Creating the lime corner dots using pseudo-elements */
  .highlight-box::before,
  .highlight-box::after {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  /* Top-left and Top-right dots mapped to --lime */
  .highlight-box::before {
    background: 
      linear-gradient(var(--lime), var(--lime)) top left / 4px 4px no-repeat,
      linear-gradient(var(--lime), var(--lime)) top right / 4px 4px no-repeat;
  }

  /* Bottom-left and Bottom-right dots mapped to --lime */
  .highlight-box::after {
    background: 
      linear-gradient(var(--lime), var(--lime)) bottom left / 4px 4px no-repeat,
      linear-gradient(var(--lime), var(--lime)) bottom right / 4px 4px no-repeat;
  }

  /* --- Responsive Adjustments --- */
  @media (max-width: 1024px) {
    .the-reality__container {
      grid-template-columns: 1fr; 
      gap: 40px;
      padding: 60px 40px;
    }

    .col-2, .col-3 {
      border-left: none;
      border-top: 1px solid var(--grey-300);
      padding: 40px 0 0 0; 
    }
    
    .col-1 {
      padding-right: 0;
    }
  }
</style>
