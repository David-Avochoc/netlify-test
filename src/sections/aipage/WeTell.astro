---
import Container from "@/components/global/Container.astro";
import ScrollTabs from "@/components/ui/ScrollTabs.astro";
import Columns from "@/components/global/Columns.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";

const tabs = ["Readiness", "Discovery", "Honesty", "Risk"];
---

<section class="we-tell-section">
  <Container>
    <ScrollTabs
      tabs={tabs}
      scrollHeight="400vh"
      class="we-tell__scroll-tabs"
      gap="var(--space-8)"
    >
      <SectionTitle
        slot="heading"
        title="We'll tell you when AI is not the answer"
        fontSize="var(--font-size-36)"
        textTransform="capitalize"
        fontWeight="var(--font-weight-regular)"
      />

      <!-- Readiness -->
      <div
        class="scroll-tabs__panel"
        id="scroll-panel-0"
        role="tabpanel"
        aria-labelledby="scroll-tab-0"
      >
        <Columns
          layout="33-33-33"
          gap="1rem"
          align="center"
          class="we-tell__panel"
        >
          <div class="panel-left">
            <h3>Readiness</h3>
            <span class="phonetic"> /'rɛdɪnɪs/ </span>
            <p class="definition">
              being fully prepared for action or showing a clear willingness to
              do something.
            </p>
          </div>
          <div class="panel-center">
            <img
              src="/images/visuals/Ai_Page.Readiness.svg"
              alt="Readiness"
              loading="lazy"
            />
          </div>
          <div class="panel-right">
            <span class="step">01/04</span>
            <h4>Not everything needs AI</h4>
            <p>
              Some workflows are ready. Some aren't yet. Some never will be —
              and that's fine.
            </p>
          </div>
        </Columns>
      </div>

      <!-- Discovery -->
      <div
        class="scroll-tabs__panel"
        id="scroll-panel-1"
        role="tabpanel"
        aria-labelledby="scroll-tab-1"
      >
        <Columns
          layout="33-33-33"
          gap="1rem"
          align="center"
          class="we-tell__panel"
        >
          <div class="panel-left">
            <h3>Discovery</h3>
            <span class="phonetic"> /dɪˈskʌv(ə)ri/ </span>
            <p class="definition">
              the action or process of finding something or finding out about
              something for the first time.
            </p>
          </div>
          <div class="panel-center">
            <img
              src="/images/visuals/Ai_Page_Discovery.svg"
              alt="Discovery"
              loading="lazy"
            />
          </div>
          <div class="panel-right">
            <span class="step">02/04</span>
            <h4>Finding the real problem</h4>
            <p>
              We don't start with solutions. We look at your current systems to
              find out where the friction actually lives.
            </p>
          </div>
        </Columns>
      </div>

      <!-- Honesty -->
      <div
        class="scroll-tabs__panel"
        id="scroll-panel-2"
        role="tabpanel"
        aria-labelledby="scroll-tab-2"
      >
        <Columns
          layout="33-33-33"
          gap="1rem"
          align="center"
          class="we-tell__panel"
        >
          <div class="panel-left">
            <h3>Honesty</h3>
            <span class="phonetic"> /ˈɒnɪsti/ </span>
            <p class="definition">
              the quality of being free of deceit; truthfulness; sincerity.
            </p>
          </div>
          <div class="panel-center">
            <img
              src="/images/visuals/Ai_Page _Honesty.svg"
              alt="Honesty"
              loading="lazy"
            />
          </div>
          <div class="panel-right">
            <span class="step">03/04</span>
            <h4>No buzzwords allowed</h4>
            <p>
              If a simple database query does the job better than a language
              model, we will tell you to use the database.
            </p>
          </div>
        </Columns>
      </div>

      <!-- Risk -->
      <div
        class="scroll-tabs__panel"
        id="scroll-panel-3"
        role="tabpanel"
        aria-labelledby="scroll-tab-3"
      >
        <Columns
          layout="33-33-33"
          gap="1rem"
          align="center"
          class="we-tell__panel"
        >
          <div class="panel-left">
            <h3>Risk</h3>
            <span class="phonetic"> /rɪsk/ </span>
            <p class="definition">
              a situation involving exposure to danger, harm, or loss.
            </p>
          </div>
          <div class="panel-center">
            <img
              src="/images/visuals/ai_page_risk.svg"
              alt="Risk"
              loading="lazy"
            />
          </div>
          <div class="panel-right">
            <span class="step">04/04</span>
            <h4>Protecting the core</h4>
            <p>
              Innovation shouldn't break daily operations. We assess the
              vulnerabilities before writing a single line of code.
            </p>
          </div>
        </Columns>
      </div>

      <p slot="footer" class="we-tell__footer">
        Four checks. No guesswork. Nothing else.
      </p>
    </ScrollTabs>
  </Container>
</section>

<style>
  :global(.we-tell-section .container) {
    padding: 0px;
    background: var(--white);
  }
  .scroll-tabs__panel {
    padding-inline: var(--space-64);
  }
  .panel-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 24.562rem;
  }
  .panel-left h3 {
    font-size: var(--font-size-36);
    font-weight: var(--font-weight-bold);
    color: var(--navy);
    letter-spacing: -0.045rem;
  }
  .panel-left .phonetic,
  .panel-left p {
    font-size: var(--font-size-14);
    color: var(--navy);
    line-height: 1.5;
  }
  .panel-center {
    display: flex;
    justify-content: center;
  }
  .panel-center img {
    max-width: 100%;
    height: auto;
    max-height: 350px;
    object-fit: contain;
    animation: bob 3s ease-in-out infinite;
  }
  @keyframes bob {
    0% {
      transform: translateY(0);
      filter: drop-shadow(0 5px 5px rgba(0, 0, 0, 0.05));
    }
    50% {
      transform: translateY(-15px);
      filter: drop-shadow(0 15px 10px rgba(0, 0, 0, 0.15));
    }
    100% {
      transform: translateY(0);
      filter: drop-shadow(0 5px 5px rgba(0, 0, 0, 0.05));
    }
  }
  .panel-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 21.937rem;
    margin-inline: auto 0;
  }
  .panel-right .step {
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-medium);
    color: var(--grey-400);
  }
  .panel-right h4 {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-semibold);
    color: var(--navy);
  }
  .panel-right p {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-regular);
    color: var(--navy);
  }
  p.we-tell__footer {
    font-size: var(--font-size-18);
    font-weight: var(--font-weight-semibold);
    color: var(--navy);
    text-transform: uppercase;
  }

  @media only screen and (max-width: 799px) {
    :global(.we-tell__panel.columns--stack) {
      gap: 0rem;
    }
    :global(.scroll-tabs__inner) {
      padding-inline: var(--space-16);
    }
    :global(.scroll-tabs__tabs) {
      display: none !important;
    }
    .panel-center {
      order: 1;
      margin-bottom: var(--space-32);
    }
    .panel-left {
      order: 2;
      padding: var(--space-36) 0;
      border: 1px solid rgba(234, 236, 240, 0.25);
      border-top-left-radius: var(--border-radius-small);
      border-top-right-radius: var(--border-radius-small);
      border-bottom: none;
    }
    .panel-right {
      order: 3;
      padding-bottom: var(--space-36);
      border: 1px solid rgba(234, 236, 240, 0.25);
      border-bottom-left-radius: var(--border-radius-small);
      border-bottom-right-radius: var(--border-radius-small);
      border-top: none;
    }
    .panel-left,
    .panel-right {
      padding-inline: var(--space-16);
      max-width: 100%;
      background: rgba(234, 236, 240, 0.1);
    }
    .panel-right .step {
      color: var(--white);
    }

    .scroll-tabs__panel {
      padding: 0;
      align-items: flex-end;
    }
  }
</style>
