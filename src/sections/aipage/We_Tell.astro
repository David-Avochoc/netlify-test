---
import Container from "@/components/global/Container.astro";

const tabsData = [
  {
    id: "readiness",
    label: "READINESS",
    word: "Readiness",
    phonetic: "/'rɛdɪnɪs/",
    definition: "being fully prepared for action or showing a clear willingness to do something.",
    image: "/images/Ai-Page/Ai_Page.Readiness.svg", 
    step: "01/04",
    title: "Not everything needs AI",
    description: "Some workflows are ready. Some aren't yet. Some never will be — and that's fine."
  },
  {
    id: "discovery",
    label: "DISCOVERY",
    word: "Discovery",
    phonetic: "/dɪˈskʌv(ə)ri/",
    definition: "the action or process of finding something or finding out about something for the first time.",
    image: "/images/Ai-Page/Ai_Page_Discovery.svg", 
    step: "02/04",
    title: "Finding the real problem",
    description: "We don't start with solutions. We look at your current systems to find out where the friction actually lives."
  },
  {
    id: "honesty",
    label: "HONESTY",
    word: "Honesty",
    phonetic: "/ˈɒnɪsti/",
    definition: "the quality of being free of deceit; truthfulness; sincerity.",
    image: "/images/Ai-Page/Ai_Page _Honesty.svg",
    step: "03/04",
    title: "No buzzwords allowed",
    description: "If a simple database query does the job better than a language model, we will tell you to use the database."
  },
  {
    id: "risk",
    label: "RISK",
    word: "Risk",
    phonetic: "/rɪsk/",
    definition: "a situation involving exposure to danger, harm, or loss.",
    image: "/images/Ai-Page/Ai_Paage_Risk.png",
    step: "04/04",
    title: "Protecting the core",
    description: "Innovation shouldn't break daily operations. We assess the vulnerabilities before writing a single line of code."
  }
];
---

<div class="we-tell-pin-wrapper">
  <section class="we-tell">
    <Container>
      <div class="we-tell__container">
        <h2>We'll tell you when AI is not the answer.</h2>

        <!-- Tab Buttons -->
        <div class="we-tell__tabs" role="tablist">
          {tabsData.map((tab, index) => (
            <button 
              class:list={['tab-btn', { active: index === 0 }]} 
              data-target={tab.id}
              role="tab"
            >
              {tab.label}
            </button>
          ))}
        </div>

        
        <div class="we-tell__content-wrapper">
          {tabsData.map((tab, index) => (
            <div 
              class:list={['tab-panel', { active: index === 0 }]} 
              id={tab.id}
              role="tabpanel"
            >
              <div class="panel-left">
                <h3>{tab.word}</h3>
                <span class="phonetic">{tab.phonetic}</span>
                <p class="definition">{tab.definition}</p>
              </div>

              <div class="panel-center">
                <img src={tab.image} alt={tab.word} loading="lazy" />
              </div>

              <div class="panel-right">
                <span class="step">{tab.step}</span>
                <h4>{tab.title}</h4>
                <p class="description">{tab.description}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="we-tell__footer">FOUR CHECKS. NO GUESSWORK. NOTHING ELSE.</p>
      </div>
    </Container>
  </section>
</div>

<style>

  .we-tell-pin-wrapper {
    height: 400vh;
    position: relative;
  }

  .we-tell {
    position: sticky;
    top: 0;
    height: 100vh; 
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0;
    background: linear-gradient(180deg, var(--grey-100) 0%, #68a9a4 100%);
    color: var(--charcoal);
    overflow: hidden;
    font-family: var(--font-family-primary);
  }

  .we-tell__container {
    margin: 0 auto;
    padding: 0 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  h2 {
    font-size: var(--font-size-48);
    font-weight: var(--font-weight-medium);
    color: var(--navy);
    margin-bottom: 40px;
    text-align: center;
  }

  .we-tell__tabs {
    display: flex;
    gap: 16px;
    margin-bottom: 80px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tab-btn {
    padding: 12px 30px;
    border-radius: 50px;
    border: 1px solid var(--grey-400);
    background: transparent;
    color: var(--grey-500);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.5px;
    /* Disable clicking */
    pointer-events: none;
    transition: all 0.3s ease;
  }

  .tab-btn.active {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }

  .we-tell__content-wrapper {
    position: relative;
    width: 100%;
    /* Keep space reserved for the panels so layout doesn't jump */
    min-height: 350px; 
    margin-bottom: 60px;
  }

  .tab-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    align-items: center;
    
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease, visibility 0.5s;
  }

  .tab-panel.active {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    z-index: 2;
  }

  .panel-left h3 {
    font-size: var(--font-size-48);
    font-weight: var(--font-weight-bold);
    margin: 0 0 8px 0;
    color: var(--navy);
  }

  .phonetic {
    display: block;
    font-family: monospace;
    color: var(--grey-500);
    margin-bottom: 20px;
    font-size: var(--font-size-16);
  }

  .definition {
    font-size: var(--font-size-16);
    line-height: 1.6;
    color: var(--charcoal);
  }

  .panel-center {
    display: flex;
    justify-content: center;
  }

  .panel-center img {
    max-width: 100%;
    height: auto;
    max-height: 350px;
    object-fit: contain;
    /* Applied animation directly to the image so it bobs continuously */
    animation: bob 3s ease-in-out infinite;
  }

  /* Continuous bobbing animation */
  @keyframes bob {
    0% {
      transform: translateY(0);
      filter: drop-shadow(0 5px 5px rgba(0, 0, 0, 0.05));
    }
    50% {
      transform: translateY(-15px);
      filter: drop-shadow(0 15px 10px rgba(0, 0, 0, 0.15));
    }
    100% {
      transform: translateY(0);
      filter: drop-shadow(0 5px 5px rgba(0, 0, 0, 0.05));
    }
  }

  .step {
    display: block;
    font-size: var(--font-size-16);
    color: var(--grey-400);
    margin-bottom: 16px;
    font-weight: var(--font-weight-medium);
  }

  .panel-right h4 {
    font-size: var(--font-size-30);
    font-weight: var(--font-weight-bold);
    margin: 0 0 16px 0;
    color: var(--navy);
  }

  .description {
    font-size: var(--font-size-20);
    line-height: 1.5;
    color: var(--charcoal);
  }

  .we-tell__footer {
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-bold);
    color: var(--navy);
    letter-spacing: 1px;
    text-align: center;
    margin: 0;
  }

  @media (max-width: 900px) {
    .tab-panel {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 30px;
    }
    .we-tell__content-wrapper {
      min-height: 751px;
    }
  }
</style>

<script>
  function initScrollTabs() {
    const wrapper = document.querySelector('.we-tell-pin-wrapper');
    const buttons = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    const totalTabs = panels.length;
    let currentIndex = 0;

    if (!wrapper || totalTabs === 0) return;

    window.addEventListener('scroll', () => {
      const rect = wrapper.getBoundingClientRect();
      

      const scrollableDistance = rect.height - window.innerHeight;
      const scrolled = -rect.top;
      
      let progress = scrolled / scrollableDistance;

      if (progress < 0) progress = 0;
      if (progress > 1) progress = 1;

      let activeIndex = Math.floor(progress * totalTabs);
      
      if (activeIndex >= totalTabs) {
        activeIndex = totalTabs - 1;
      }

      if (activeIndex !== currentIndex) {
        currentIndex = activeIndex;

        buttons.forEach((btn, i) => {
          if (i === currentIndex) btn.classList.add('active');
          else btn.classList.remove('active');
        });

        panels.forEach((panel, i) => {
          if (i === currentIndex) panel.classList.add('active');
          else panel.classList.remove('active');
        });
      }
    }, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initScrollTabs);
</script>
