---
const tabsData = [
  {
    id: "readiness",
    label: "READINESS",
    word: "Readiness",
    phonetic: "/'rɛdɪnɪs/",
    definition: "being fully prepared for action or showing a clear willingness to do something.",
    image: "/images/Ai-Page/Ai_Page.Readiness.svg", 
    step: "01/04",
    title: "Not everything needs AI",
    description: "Some workflows are ready. Some aren't yet. Some never will be — and that's fine."
  },
  {
    id: "discovery",
    label: "DISCOVERY",
    word: "Discovery",
    phonetic: "/dɪˈskʌv(ə)ri/",
    definition: "the action or process of finding something or finding out about something for the first time.",
    image: "/images/Ai-Page/Ai_Page_Discovery.svg", 
    step: "02/04",
    title: "Finding the real problem",
    description: "We don't start with solutions. We look at your current systems to find out where the friction actually lives."
  },
  {
    id: "honesty",
    label: "HONESTY",
    word: "Honesty",
    phonetic: "/ˈɒnɪsti/",
    definition: "the quality of being free of deceit; truthfulness; sincerity.",
    image: "/images/Ai-Page/Ai_Page _Honesty.svg",
    step: "03/04",
    title: "No buzzwords allowed",
    description: "If a simple database query does the job better than a language model, we will tell you to use the database."
  },
  {
    id: "risk",
    label: "RISK",
    word: "Risk",
    phonetic: "/rɪsk/",
    definition: "a situation involving exposure to danger, harm, or loss.",
    image: "/images/Ai-Page/Ai_Paage_Risk.png",
    step: "04/04",
    title: "Protecting the core",
    description: "Innovation shouldn't break daily operations. We assess the vulnerabilities before writing a single line of code."
  }
];
---

<section class="we-tell">
  <div class="we-tell__container">
    <h2>We'll tell you when AI is not the answer.</h2>

    <!-- Tab Buttons -->
    <div class="we-tell__tabs" role="tablist">
      {tabsData.map((tab, index) => (
        <button 
          class={`tab-btn ${index === 0 ? 'active' : ''}`} 
          data-target={tab.id}
          role="tab"
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Tab Panels -->
    <div class="we-tell__content-wrapper">
      {tabsData.map((tab, index) => (
        <div 
          class={`tab-panel ${index === 0 ? 'active' : ''}`} 
          id={tab.id}
          role="tabpanel"
        >
          <div class="panel-left">
            <h3>{tab.word}</h3>
            <span class="phonetic">{tab.phonetic}</span>
            <p class="definition">{tab.definition}</p>
          </div>

          <div class="panel-center">
            <img src={tab.image} alt={tab.word} loading="lazy" />
          </div>

          <div class="panel-right">
            <span class="step">{tab.step}</span>
            <h4>{tab.title}</h4>
            <p class="description">{tab.description}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="we-tell__footer">FOUR CHECKS. NO GUESSWORK. NOTHING ELSE.</p>
  </div>
</section>

<style>
  .we-tell {
    width: 100%;
    padding: 100px 0 60px;
    background: linear-gradient(180deg, #f7f9fa 0%, #68a9a4 100%);
    color: #1a2332;
    overflow: hidden;
  }

  .we-tell__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    font-size: 42px;
    font-weight: 500;
    margin-bottom: 40px;
    text-align: center;
  }

  
  .we-tell__tabs {
    display: flex;
    gap: 16px;
    margin-bottom: 80px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tab-btn {
    padding: 12px 30px;
    border-radius: 50px;
    border: 1px solid #7c8694;
    background: transparent;
    color: #4a5568;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .tab-btn.active, .tab-btn:hover {
    background: #1e293b;
    border-color: #1e293b;
    color: #ffffff;
  }


  .we-tell__content-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 64px;
    margin-bottom: 60px;
  }

  .tab-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    align-items: center;
    
   
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease, visibility 0.5s;
  }

  .tab-panel.active {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    z-index: 2;
  }

  
  .panel-left h3 {
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #1e293b;
  }

  .phonetic {
    display: block;
    font-family: monospace;
    color: #4a5568;
    margin-bottom: 20px;
    font-size: 16px;
  }

  .definition {
    font-size: 16px;
    line-height: 1.6;
    color: #1e293b;
  }

  /* Center Column */
  .panel-center {
    display: flex;
    justify-content: center;
  }

  .panel-center img {
    max-width: 100%;
    height: auto;
    max-height: 350px;
    object-fit: contain;
  }

  /* Right Column */
  .step {
    display: block;
    font-size: 16px;
    color: #7c8694;
    margin-bottom: 16px;
    font-weight: 500;
  }

  .panel-right h4 {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 16px 0;
    color: #1e293b;
  }

  .description {
    font-size: 20px;
    line-height: 1.5;
    color: #1e293b;
  }

  /* Footer */
  .we-tell__footer {
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: 1px;
    text-align: center;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .tab-panel {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 30px;
    }
    .we-tell__content-wrapper {
      min-height: 751px;
    }
  }
</style>

<script>
  // This runs on the client to handle the tab switching
  function initTabs() {
    const buttons = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        // Remove active class from all buttons and panels
        buttons.forEach(btn => btn.classList.remove('active'));
        panels.forEach(panel => panel.classList.remove('active'));

        // Add active class to clicked button and corresponding panel
        button.classList.add('active');
        const targetId = button.getAttribute('data-target');
        document.getElementById(targetId).classList.add('active');
      });
    });
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', initTabs);
</script>
