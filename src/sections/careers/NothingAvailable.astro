---
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import PrimaryBtn from "@/components/buttons/PrimaryBtn.astro";
---

<section class="avo-nothing-available" id="avo-nothing-available">
  <Container>
    <Columns layout="custom" customColumns="1fr">
      <div class="avo-nothing-available-inner">
        <SectionTitle
          title="Nothing available for you right now?"
          fontSize="var(--font-size-36)"
          fontWeight="var(--font-weight-medium)"
          textTransform="sentencecase"
          class="avo-hiring__title"
        />
        <h3>Submit your cv to stay on our radar</h3>
        <div class="avo-nothing-available-inner__cta">
          <PrimaryBtn
            href="/careers/apply-now"
            text="Send us your details"
            background="var(--navy)"
            textColor="var(--white)"
          />
        </div>
      </div>
    </Columns>
  </Container>
</section>

<style>
  .avo-nothing-available-inner {
    padding-block: var(--space-120);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    text-align: center;
  }
  .avo-nothing-available-inner h3 {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-regular);
    color: var(--navy);
  }
</style>
