---
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SecondaryBtn from "@/components/buttons/SecondaryBtn.astro";
import PrimaryBtn from "@/components/buttons/PrimaryBtn.astro";

const videoPath = "public/videos/Hero-Vid.mp4"; 
---

<section class="hero-wrapper">
  <video class="bg-video" muted loop playsinline>
    <source src={videoPath} type="video/mp4" />
  </video>

  <div class="content-container">
    <Container>
      <Columns class="interactive-columns" layout="50-50" align="center">
        
        <div class="interactive-column">
          <div class="video-card">
            <video class="card-video" muted loop playsinline>
              <source src={videoPath} type="video/mp4" />
            </video>
          </div>
        </div>

        <div class="text-column">
          <h1>
            Custom software and AI built to work<br/>
            with your systems, <span class="dimmed">not replace them.</span>
          </h1>
          
          <div class="hero__actions">
            <SecondaryBtn href="/contact" text="Talk to our team" />
            <PrimaryBtn
              href="#"
              text="Take our AI maturity assessment"
              background="var(--white)"
              textColor="var(--navy)"
            />
          </div>
        </div>

      </Columns>
    </Container>
  </div>
</section>

<style>
  .hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: linear-gradient(135deg, #2b6b77, #66839d, #c5a3d6); 
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .bg-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0; /* Hidden by default */
    transition: opacity 0.5s ease;
    z-index: 1;
  }

  .content-container {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 120px 0; 
  }

  .video-card {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: linear-gradient(145deg, #1d2f47, #3fa1a5); 
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    transition: transform 0.3s ease;
  }

  .video-card:hover {
    transform: scale(1.02);
  }

  .card-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0; /* Hidden to show the gradient until hovered */
    transition: opacity 0.4s ease;
  }

  .text-column {
    transition: opacity 0.4s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .text-column.fade-out {
    opacity: 0;
    pointer-events: none; /* Prevents hidden buttons from being clickable */
  }

  .text-column h1 {
    font-size: var(--font-size-60, 2.5rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--white, #ffffff);
    line-height: 1.1;
    margin-bottom: 40px;
    letter-spacing: -0.075rem;
  }

  .dimmed {
    color: rgba(255, 255, 255, 0.55);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-16, 16px);
    flex-wrap: wrap;
  }
</style>

<script>
  function initInteractiveHero() {
    const videoCard = document.querySelector('.video-card');
    const bgVideo = document.querySelector('.bg-video') as HTMLVideoElement;
    const cardVideo = document.querySelector('.card-video') as HTMLVideoElement;
    const textColumn = document.querySelector('.text-column');

    if (!videoCard || !bgVideo || !cardVideo || !textColumn) return;

    videoCard.addEventListener('mouseenter', () => {
      bgVideo.style.opacity = "1";
      cardVideo.style.opacity = "1"; 
      
      textColumn.classList.add('fade-out');
      
      bgVideo.play();
      cardVideo.play();
    });

    videoCard.addEventListener('mouseleave', () => {
      bgVideo.style.opacity = "0";
      cardVideo.style.opacity = "0";
      
      textColumn.classList.remove('fade-out');
      
      bgVideo.pause();
      cardVideo.pause();
    });
  }

  document.addEventListener("DOMContentLoaded", initInteractiveHero);
</script>
