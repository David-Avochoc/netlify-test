---
import Container from "@/components/global/Container.astro";
import HighlightSection from "@/components/ui/HighlightSection.astro";
---

<section class="iso-highlight-section">
  <Container>
    <HighlightSection
      columns={2}
      customColumns="9.375rem minmax(0, 1fr)"
      gap="var(--space-24)"
      accentColor="transparent"
      padding="0"
    >
      <div class="iso-certification-badge">
        <img src="/images/iso_badge.svg" alt="ISO Certification" />
      </div>
      <div class="iso-heading">
        <h4>
          ISO 27001 certified · POPIA and GDPR compliant
          <span class="iso-heading-subtext"
            >Our compliance is built to grow as regulations change.</span
          >
        </h4>
      </div>
    </HighlightSection>
  </Container>
</section>

<style>
  .iso-highlight-section :global(.highlight-section)::before {
    position: relative;
    background: none;
  }
  .iso-highlight-section :global(.highlight-section) {
    margin: auto;
    padding-block: 0 var(--space-100);
    border-bottom: 1px solid var(--navy);
  }
  .iso-highlight-section :global(.highlight-section__inner),
  .iso-heading,
  .iso-certification-badge {
    margin: auto;
  }
  .iso-certification-badge img {
    width: 9.375rem;
  }
  .iso-highlight-section {
    padding-block: var(--space-64);
  }
  .iso-heading h4 {
    font-size: var(--font-size-36);
    font-weight: var(--font-weight-regular);
    line-height: 1.2;
    letter-spacing: -0.045rem;
  }
  .iso-heading-subtext {
    display: block;
    color: var(--grey-500);
  }
  @media screen and (max-width: 799px) {
    .iso-highlight-section :global(.highlight-section) {
      padding-block: 0 var(--space-32);
    }
  }
</style>
