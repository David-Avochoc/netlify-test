---
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import HighlightSection from "@/components/ui/HighlightSection.astro";
---

<section class="compliance-first-section">
  <Container>
    <HighlightSection
      columns={3}
      customColumns="9.75rem minmax(0, 1fr) minmax(0, 1fr)"
      background="transparent"
      textColor="var(--navy)"
      padding="var(--space-8) var(--space-16)"
      minHeight="21.562rem"
    >
      <div class="iso-certification-badge">
        <img src="/images/iso_badge.svg" alt="ISO Certification" />
      </div>

      <div class="iso-heading">
        <span class="certified-pill">ISO 27001 Certified</span>
        <h4>
          Why clients keep coming back.
        </h4>
      </div>

      <div class="iso-description">
        <p>
          One of our clients has worked with us for over 10 years, and counting. That's not an accident. We hold ISO 27001 for information security, and we treat every engagement as the start of a long-term relationship, not a single delivery.
        </p>
      </div>
    </HighlightSection>
  </Container>
</section>

<style>
  .compliance-first-section {
    padding-block: var(--space-64);
    background-color: var(--grey);
  }

  .iso-certification-badge img {
    display: block;
    width: 100%;
    height: auto;
  }

  .certified-pill {
    background-color: var(--grey-300);
    border-radius: 34px;
    padding-inline: var(--space-16);
    padding-block: var(--space-8);
    color: var(--navy);
    font-size: var(--font-size-12);
    text-transform: uppercase;
    font-weight: var(--font-weight-medium);
  }

  .iso-heading h4 {
    font-size: var(--font-size-36);
    font-weight: var(--font-weight-regular);
    line-height: 1.2;
    letter-spacing: -0.045rem;
    max-width: 23rem;
    margin-top: var(--space-8);
  }

  .iso-description p {
    font-size: var(--font-size-24);
    line-height: 1.3;
    max-width: 28.812rem;
  }

  @media only screen and (max-width: 799px) {
    :global(.highlight-section) {
      padding: var(--space-32) !important;
    }
    .iso-certification-badge img {
      max-width: 7.5rem;
      margin: auto;
    }
    .iso-heading {
      text-align: center;
    }
    .iso-heading h4 {
      text-align: left;
      margin-top: 32px;
      font-size: var(--font-size-30);
    }
    .iso-description p {
      font-size: var(--font-size-18);
    }
  }
</style>
