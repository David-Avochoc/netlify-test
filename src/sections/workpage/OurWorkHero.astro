---
import Hero from "@/sections/shared-sections/Hero.astro";
import Container from "@/components/global/Container.astro";
import Columns from "@/components/global/Columns.astro";
import SecondaryBtn from "@/components/buttons/SecondaryBtn.astro";
import PrimaryBtn from "@/components/buttons/PrimaryBtn.astro";
---

<section class="our-work-section" id="our-work-section">
    <Hero backgroundImage="/images/backgrounds/hero/hero_image3.webp">
        <Container>
            <Columns class="our-work-hero-columns" layout="50-50" gap="var(--space-20)">
                <div class="our-work-hero-left">
                    <h1>
                        Proof,<br />
                        not promises.
                    </h1>
                </div>
                <div class="our-work-hero-right">
                    <p>
                        A decade of custom software and AI, built for organisations that need it to work properly, for years, under real pressure.
                    </p>
                    <div class="hero__actions">
                        <SecondaryBtn href="/contact" text="Start a conversation" />
                        <PrimaryBtn
                            href="/services"
                            text="See our services"
                            background="var(--white)"
                            textColor="var(--navy)"
                        />
                    </div>
                </div>
            </Columns>
        </Container>
    </Hero>
</section>

<style>
    :global(.our-work-hero-columns) {
        min-height: 25.687rem;
    }
    .our-work-hero-left h1 {
        font-size: var(--font-size-60);
        font-weight: var(--font-weight-semibold);
        color: var(--grey);
        letter-spacing: -0.075rem;
    }
    .our-work-hero-right {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        margin-top: auto;
    }
    .our-work-hero-right p {
        font-size: var(--font-size-24);
        font-weight: var(--font-weight-regular);
        color: var(--white);
        line-height: 1.3;
        padding-bottom: var(--space-24);
    }
    .hero__actions {
        display: flex;
        gap: var(--space-16);
    }

  @media only screen and (max-width: 799px) {
    .our-work-hero-left h1 {
        font-size: var(--font-size-48);
        letter-spacing: -0.06rem;        
    }
    .hero__actions {
      display: flex;
      flex-direction: column;
      gap: var(--space-24);
    }     
</style>
